# Hostaway API credentials — get these from Hostaway > Settings > API
HOSTAWAY_ACCOUNT_ID=your_account_id
HOSTAWAY_API_KEY=your_api_key

# Comma-separated list of OTA placeholder phone numbers that indicate an Agoda
# booking (Agoda masks the real guest number with one of these). Digits are
# compared after stripping everything but numbers, so formatting doesn't matter.
AGODA_PLACEHOLDER_PHONES=+9712035640799

# Port the dashboard server listens on
PORT=3000
